# Supabase — público (vai para o client bundle)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase — NUNCA expor no client (sem prefixo NEXT_PUBLIC_)
# Necessário apenas se houver Route Handler que precise de bypass de RLS
# SUPABASE_SERVICE_ROLE_KEY=

# Eva — ativação da secretária no WhatsApp (server-side apenas, NUNCA NEXT_PUBLIC_)
# URL do webhook n8n "Eva — Ativação (DM)" que registra o canal e manda as boas-vindas.
EVA_ACTIVATION_WEBHOOK_URL=
# Segredo forte compartilhado com o n8n (header X-Eva-Secret). Nunca versionar o valor real.
EVA_WEBHOOK_SECRET=
# Número da própria instância Evolution (só dígitos, com 55). Evita ativar a Eva no próprio número (loop fromMe).
EVA_INSTANCE_NUMBER=
